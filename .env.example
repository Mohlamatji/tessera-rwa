# Copy to .env and load it:  node --env-file=.env index.js
# (or set these as real environment variables, or use config/local.js - see config/local.js.example)

PORT=8000
# development (default: zero-setup demo) | production (fail-closed, see README)
APP_ENV=development
DEMO_MODE=

# REQUIRED in production, 32+ random chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=change-me-to-a-random-32-byte-value
# Prefer a hash (see config/security.js)
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
TRUST_PROXY_HEADERS=0

# --- KYC / AML provider: mock | (your adapter, see app/Services/VerificationAdapters) ---
VERIFICATION_PROVIDER=mock
KYC_VALID_DAYS=365

# --- Blockchain (EVM-compatible: Base, Polygon, Celo, Lisk, Arbitrum, Optimism, any L2...) ---
CHAIN_ENABLED=0
CHAIN_NAME=Base Sepolia
CHAIN_ID=84532
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_EXPLORER_URL=https://sepolia.basescan.org
CHAIN_START_BLOCK=0
# Printed by `cd chain && npm run deploy`
REGISTRY_ADDRESS=
FACTORY_ADDRESS=
MARKET_ADDRESS=
ANCHOR_ADDRESS=
TOKEN_ADDRESS=
# Proof of backing (custodian-signed attestations; marketplace halts buying on a shortfall)
BACKING_ADDRESS=
# MOCK custodian key for demos only. In production the real custodian signs on its own systems.
CUSTODIAN_PRIVATE_KEY=
# Cash-out: stablecoin sent here is paid out to mobile money (partner treasury). Provider is simulated by default.
OFFRAMP_ADDRESS=
PAYOUT_PROVIDER=mock
PAYOUT_FEE_BPS=150
TOKEN_SYMBOL=mZAR
TOKEN_DECIMALS=6
# Signs KYC claims ONLY (no funds). Generate: node chain/scripts/generate-attestor-key.js
ATTESTOR_PRIVATE_KEY=

CURRENCY_CODE=ZAR
CURRENCY_SYMBOL=R
