/**
 * ============================================================================
 *  DO NOT EDIT THIS FILE. IT SHIPS PUBLICLY AND IS NOT GITIGNORED.
 *
 *  1. COPY it:      cp config/local.js.example config/local.js
 *  2. EDIT THE COPY (config/local.js, no ".example") with your real values.
 *  3. Never touch this .example file again.
 *
 *  config/local.js is the ONLY place real secrets belong. It's gitignored, it's
 *  excluded from every zip, and it's the file the app actually loads (see
 *  public/index.js) BEFORE any other config is read.
 * ============================================================================
 */
process.env.CHAIN_ENABLED = '1';
process.env.CHAIN_NAME = 'Base Sepolia';
process.env.CHAIN_ID = '84532';
process.env.CHAIN_RPC_URL = 'https://sepolia.base.org';
process.env.CHAIN_EXPLORER_URL = 'https://sepolia.basescan.org';

// Paste the lines printed by `npm run deploy` (chain/):
process.env.REGISTRY_ADDRESS = '0x...';
process.env.FACTORY_ADDRESS = '0x...';
process.env.MARKET_ADDRESS = '0x...';
process.env.ANCHOR_ADDRESS = '0x...';
process.env.TOKEN_ADDRESS = '0x...';
process.env.BACKING_ADDRESS = '0x...';     // BackingOracle (proof of backing)
// Optional: cash-out to mobile money. The provider is SIMULATED unless you plug in a real off-ramp adapter.
// process.env.OFFRAMP_ADDRESS = '0x...';
// MOCK custodian key for demos only (real custodians sign on their own systems):
// process.env.CUSTODIAN_PRIVATE_KEY = '0x...';
process.env.CHAIN_START_BLOCK = '0';   // the block the contracts were deployed at - makes the first sync fast

// Signs KYC claims only. Holds NO funds. Generate with: node chain/scripts/generate-attestor-key.js
process.env.ATTESTOR_PRIVATE_KEY = 'REPLACE_WITH_YOUR_REAL_KEY_IN_local.js_NOT_HERE';

